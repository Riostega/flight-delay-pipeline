# Flight status API — https://aviationstack.com
FLIGHT_API_KEY=

# Weather API — https://openweathermap.org/api
WEATHER_API_KEY=

# AWS S3 (raw landing zone)
# The two keys are for the LAPTOP only. On the EC2 host, DELETE both lines:
# the host gets S3 access from its IAM instance role, and keys here would
# override the role. Leaving them blank is not enough (boto3 then signs with
# empty keys), and bootstrap.sh refuses to run while either line exists.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET_NAME=

# Snowflake
# run_snowflake_setup.py creates the warehouse and database, so these names
# are what it will create rather than values you must look up.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=FLIGHT_PIPELINE_WH
SNOWFLAKE_DATABASE=FLIGHT_DELAY_PIPELINE
SNOWFLAKE_SCHEMA=PUBLIC
# Optional. Where the dashboard reads the raw VARIANT tables from, when that
# differs from SNOWFLAKE_SCHEMA (CI sets it). Defaults to PUBLIC.
# SNOWFLAKE_RAW_SCHEMA=PUBLIC
# Optional. The role pipeline sessions use. Unset means the user's default role
# (ACCOUNTADMIN on a trial account). Set to PIPELINE_ROLE once the least-privilege
# role in pipeline/snowflake_setup.sql has been applied.
# SNOWFLAKE_ROLE=PIPELINE_ROLE

# Optional — failure alerting. Unset, alerting is a silent no-op and the
# pipeline runs normally. Slack: an Incoming Webhook URL. Heartbeat: a ping
# URL from any dead-man's-switch service (healthchecks.io, Cronitor, etc),
# which the watchdog pings so an unreachable host is detectable externally.
SLACK_WEBHOOK_URL=
HEARTBEAT_URL=
# Optional. A second ping URL for the data checks. When set, HEARTBEAT_URL reports
# host liveness only and this one reports whether the checks pass.
# HEARTBEAT_CHECKS_URL=
