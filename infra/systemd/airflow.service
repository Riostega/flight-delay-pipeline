[Unit]
Description=Airflow (flight delay pipeline)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Flight_Delay_Pipeline

Environment="AIRFLOW_HOME=/home/ubuntu/airflow"
# airflow standalone spawns scheduler/api-server/triggerer/dag-processor by
# name, so the venv bin must be on PATH or the children fail to launch.
Environment="PATH=/home/ubuntu/airflow-venv/bin:/usr/local/bin:/usr/bin:/bin"
# Tasks shell out to the pipeline venv, which is kept separate because Airflow
# and dbt pin conflicting dependencies.
Environment="PIPELINE_PYTHON=/home/ubuntu/pipeline-venv/bin/python"
Environment="PIPELINE_DBT=/home/ubuntu/pipeline-venv/bin/dbt"
# The UI is only ever reached through an SSH tunnel to localhost:8080, so the
# API server listens on loopback only. The security group is then a second
# layer, not the only one: a port-8080 rule added while debugging would still
# expose nothing. (The log servers on 8793/8794 always bind to every interface,
# Airflow has no setting for them, and they only answer requests signed with
# Airflow's secret key. Keep those ports closed in the security group too.)
Environment="AIRFLOW__API__HOST=127.0.0.1"
# dags_folder and load_examples are set in airflow.cfg by bootstrap.sh, not
# here, so that `airflow` typed over SSH sees the same DAG folder as this unit.

ExecStart=/home/ubuntu/airflow-venv/bin/airflow standalone
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
