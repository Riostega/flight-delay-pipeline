[Unit]
Description=Run the flight pipeline watchdog every 30 minutes

[Timer]
# Five minutes after boot catches a host that came back up with a broken
# service, rather than waiting for the first half-hour interval to elapse.
OnBootSec=5min
OnUnitActiveSec=30min
# No Persistent=: it only applies to OnCalendar= timers, and OnBootSec above
# already covers runs missed while the host was down. If jitter were ever
# wanted, the setting is RandomizedDelaySec=, not AccuracySec=.

[Install]
WantedBy=timers.target
